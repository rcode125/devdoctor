{
  "name": "devdoctor",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform developer environment diagnostic tool",
  "license": "MIT",
  "type": "module",
  "bin": {
    "devdoctor": "apps/cli/src/index.ts"
  },
  "scripts": {
    "check": "tsx apps/cli/src/index.ts check",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop:dev": "vite --config apps/desktop/vite.config.ts",
    "desktop:build": "vite build --config apps/desktop/vite.config.ts",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "electron": "^41.10.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "execa": "^9.5.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
